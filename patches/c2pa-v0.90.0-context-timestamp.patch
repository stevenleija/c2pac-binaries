+    /// Fetch a signing timestamp using this context's resolver and progress policy.
+    pub fn request_signing_timestamp(
+        &self,
+        url: &str,
+        headers: Option<Vec<(String, String)>>,
+        body: &[u8],
+        message: &[u8],
+    ) -> Result<Vec<u8>> {
+        self.check_progress(ProgressPhase::FetchingTimestamp, 1, 2)?;
+        let result =
+            crate::crypto::time_stamp::default_rfc3161_request(url, headers, body, message, self);
+        // Check even when parsing or transport failed, so operation cancellation wins.
+        self.check_progress(ProgressPhase::FetchingTimestamp, 2, 2)?;
+        result.map_err(Error::from)
+    }
