+/// Keep timestamp transport on the operation's context rather than Signer's default context.
+struct ContextTimestampSigner<'a> {
+    signer: &'a dyn c2pa::Signer,
+    context: &'a Context,
+}
+
+impl c2pa::Signer for ContextTimestampSigner<'_> {
+    fn sign(&self, data: &[u8]) -> c2pa::Result<Vec<u8>> {
+        self.signer.sign(data)
+    }
+    fn alg(&self) -> SigningAlg {
+        self.signer.alg()
+    }
+    fn certs(&self) -> c2pa::Result<Vec<Vec<u8>>> {
+        self.signer.certs()
+    }
+    fn reserve_size(&self) -> usize {
+        self.signer.reserve_size()
+    }
+    fn time_authority_url(&self) -> Option<String> {
+        self.signer.time_authority_url()
+    }
+    fn timestamp_request_headers(&self) -> Option<Vec<(String, String)>> {
+        self.signer.timestamp_request_headers()
+    }
+    fn timestamp_request_body(&self, message: &[u8]) -> c2pa::Result<Vec<u8>> {
+        self.signer.timestamp_request_body(message)
+    }
+    fn ocsp_val(&self) -> Option<Vec<u8>> {
+        self.signer.ocsp_val()
+    }
+    fn direct_cose_handling(&self) -> bool {
+        self.signer.direct_cose_handling()
+    }
+    fn dynamic_assertions(&self) -> Vec<Box<dyn c2pa::dynamic_assertion::DynamicAssertion>> {
+        self.signer.dynamic_assertions()
+    }
+    fn send_timestamp_request(&self, message: &[u8]) -> Option<c2pa::Result<Vec<u8>>> {
+        let url = self.signer.time_authority_url()?;
+        Some((|| {
+            let body = self.signer.timestamp_request_body(message)?;
+            self.context.request_signing_timestamp(
+                &url,
+                self.signer.timestamp_request_headers(),
+                &body,
+                message,
+            )
+        })())
+    }
+}
